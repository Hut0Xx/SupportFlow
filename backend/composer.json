{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "hugocoarasa/supportflow-api",
  "type": "project",
  "description": "API REST de SupportFlow",
  "license": "MIT",
  "authors": [{ "name": "Hugo Coarasa Oliva", "role": "Full-stack developer" }],
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0",
    "laravel/reverb": "^1.6",
    "laravel/sanctum": "^4.0"
  },
  "require-dev": {
    "fakerphp/faker": "^1.24",
    "laravel/pint": "^1.24",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "pestphp/pest": "^3.8",
    "pestphp/pest-plugin-laravel": "^3.2"
  },
  "autoload": { "psr-4": { "App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/" } },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "scripts": {
    "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"],
    "test": "@php artisan test",
    "format": "pint"
  },
  "config": { "optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "allow-plugins": { "pestphp/pest-plugin": true } },
  "minimum-stability": "stable",
  "prefer-stable": true
}

